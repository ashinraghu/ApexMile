{
  // Static app in app/ plus Worker routes for place search and daily fuel prices.
  // /api/* runs worker.js; every other request is served straight from
  // the assets directory (including _headers and sw.js).
  "name": "apexmile",
  "main": "./worker.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
